generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  PERSONAL
  BANKING
  BILL_OR_UTILITY
  TRAVEL
  JOB_OR_CAREER
  HEALTHCARE
  GOVERNMENT
  EDUCATION
  SOCIAL_OR_COMMUNITY
  PRODUCT_OR_NEWSLETTER
  SMS_OR_TEXT
  PAID_RESEARCH_OR_GIG
  SHOPPING
  RETAIL_PROMO
  SUBSCRIPTION
  FREE_TRIAL
  RENEWAL_NOTICE
  PAYMENT_RECEIPT
  PRICE_INCREASE
  FAILED_PAYMENT
  ORDER_OR_SHIPPING
  ACCOUNT_SECURITY
  RAFFLE_OR_GIVEAWAY
  UNKNOWN
}

enum AlertType {
  FREE_TRIAL_ENDING
  RENEWAL_SOON
  PRICE_INCREASE
  FAILED_PAYMENT
  HIGH_OPPORTUNITY
  RAFFLE_OR_GIVEAWAY
  URGENT_DEADLINE
}

enum SubscriptionStatus {
  ACTIVE
  ENDING_SOON
  PAST_DUE
  UNKNOWN
}

enum ParseIssueType {
  EMAIL_STORAGE_FALLBACK
  CLASSIFICATION_STORAGE_FALLBACK
  EXTRACTED_PAYLOAD_FALLBACK
  LINK_SKIPPED
  PROCESSING_FAILED
}

enum ParseIssueStage {
  INGEST
  REPROCESS
}

enum ParseIssueSeverity {
  INFO
  WARN
  ERROR
}

model GmailAccount {
  id            String         @id @default(cuid())
  email         String         @unique
  tokenPath     String
  historyId     String?
  lastSyncedAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emails        Email[]
  subscriptions Subscription[]
  alerts        Alert[]
  parseIssues   ParseIssue[]
}

model Email {
  id               String          @id @default(cuid())
  gmailMessageId   String          @unique
  gmailThreadId    String?
  gmailInternalAt  DateTime?
  gmailHistoryId   String?
  gmailSizeEstimate Int?
  gmailLabels      String[]
  senderRaw        String?
  senderName       String?
  senderEmail      String?
  senderDomain     String?
  toHeader         String?
  ccHeader         String?
  bccHeader        String?
  replyTo          String?
  returnPath       String?
  deliveredTo      String?
  messageIdHeader  String?
  inReplyTo        String?
  referencesHeader String?
  listId           String?
  listUnsubscribe  String?
  listUnsubscribePost String?
  precedence       String?
  autoSubmitted    String?
  authenticationResults String?
  payloadMimeType  String?
  payloadPartCount Int?
  subject          String?
  snippet          String?
  receivedAt       DateTime?
  plainTextBody    String?
  htmlBody         String?
  rawPayload       Json?
  headersJson      Json?
  technicalFactsJson Json?
  amountsJson      Json?
  datesJson        Json?
  gmailAccountId   String
  senderId         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  gmailAccount     GmailAccount    @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
  sender           Sender?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  links            EmailLink[]
  classification   Classification?
  alerts           Alert[]
  parseIssues      ParseIssue[]
}

model EmailLink {
  id        String   @id @default(cuid())
  emailId   String
  url       String
  domain    String?
  text      String?
  createdAt DateTime @default(now())
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, url])
}

model Sender {
  id         String         @id @default(cuid())
  email      String         @unique
  name       String?
  domain     String
  emailCount Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  emails     Email[]
  subscriptions Subscription[]
}

model Classification {
  id               String    @id @default(cuid())
  emailId          String    @unique
  category         Category
  confidence       Int
  urgencyScore     Int
  opportunityScore Int
  reasons          String[]
  signalsJson      Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  email            Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String             @id @default(cuid())
  gmailAccountId   String
  senderId         String?
  vendor           String
  normalizedVendor String
  amount           Decimal?           @db.Decimal(10, 2)
  currency         String?            @default("USD")
  nextRenewalAt    DateTime?
  status           SubscriptionStatus @default(UNKNOWN)
  confidence       Int
  sourceCategory   Category?
  lastSeenAt       DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  gmailAccount     GmailAccount       @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
  sender           Sender?            @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@unique([gmailAccountId, normalizedVendor])
}

model Alert {
  id               String      @id @default(cuid())
  emailId          String
  gmailAccountId   String
  type             AlertType
  category         Category
  reason           String
  urgencyScore     Int
  opportunityScore Int
  webhookTarget    String?
  deliveredAt      DateTime?
  payloadJson      Json?
  createdAt        DateTime    @default(now())
  email            Email       @relation(fields: [emailId], references: [id], onDelete: Cascade)
  gmailAccount     GmailAccount @relation(fields: [gmailAccountId], references: [id], onDelete: Cascade)
}

model ParseIssue {
  id             String             @id @default(cuid())
  emailId        String?
  gmailAccountId String?
  gmailMessageId String
  issueType      ParseIssueType
  stage          ParseIssueStage
  severity       ParseIssueSeverity
  summary        String
  detailsJson    Json?
  occurrenceCount Int               @default(1)
  firstSeenAt    DateTime           @default(now())
  lastSeenAt     DateTime           @updatedAt
  resolvedAt     DateTime?
  email          Email?             @relation(fields: [emailId], references: [id], onDelete: SetNull)
  gmailAccount   GmailAccount?      @relation(fields: [gmailAccountId], references: [id], onDelete: SetNull)

  @@unique([gmailMessageId, issueType, stage])
}
