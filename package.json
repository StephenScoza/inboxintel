{
  "name": "inboxintel",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Gmail intelligence dashboard with deterministic classification and Discord alerts.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node -e \"require('./tests/run.js')\"",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "gmail:auth": "tsx src/gmail/auth.ts",
    "ingest": "tsx src/jobs/ingestGmail.ts",
    "worker": "tsx src/jobs/ingestGmail.ts --loop",
    "reprocess": "tsx src/jobs/reprocessEmails.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cheerio": "1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "googleapis": "^148.0.0",
    "html-to-text": "^9.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^6.8.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
